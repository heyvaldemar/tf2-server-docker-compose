# Copy to .env beside the compose file, then edit. .env is gitignored.

# ---------------------------------------------------------------- required
# A Game Server Login Token for app id 440, from
# https://steamcommunity.com/dev/managegameservers
#
# Without one the server runs and is invisible: it never appears in the public
# list, which from a player's side looks exactly like a server that is down.
TF2_SERVER_STEAM_TOKEN=

# Anyone with this can run any command on the server. Generate one:
#   openssl rand -base64 24 | tr -d '/+=' | head -c 32
TF2_SERVER_RCON_PASSWORD=

# ---------------------------------------------------------------- the server
# The name players see is set in server.cfg, not here: the launcher drops
# everything after a `|` in a command-line argument.
TF2_SERVER_MAX_PLAYERS=24
TF2_SERVER_START_MAP=koth_harvest_final
# 255 = let Steam pick from the address; 0-7 pin a region.
TF2_SERVER_REGION=255

# ---------------------------------------------------------------- networking
# Game, query and rcon port. Published on the host under the same number on
# purpose: Steam's list records the port the server BINDS, so publishing a
# different one outside hands players an address where a different server
# answers.
TF2_SERVER_PORT=27015

# ---------------------------------------------------------------- overridable defaults
# Everything below has a working default in the compose file; set it here only
# to change it, and the change survives every git pull.
#
# TF2_SERVER_IMAGE_VERSION=latest@sha256:...
# TF2_SERVER_IMAGE_TAG=lacledeslan/gamesvr-tf2:latest
#
# 4g is measured: a full 24-slot server peaked at 1.57 GB. The ceiling exists
# so a leak here cannot get some other container killed instead.
# TF2_SERVER_MEMORY_LIMIT=4g
# TF2_SERVER_CPU_LIMIT=2.0
# TF2_SERVER_MEMORY_RESERVATION=1g
# TF2_SERVER_CPU_RESERVATION=0.5
#
# TF2_SERVER_START_PERIOD=3m
# TF2_SERVER_STOP_GRACE_PERIOD=30s
# TF2_SERVER_LOG_MAX_SIZE=10m
# TF2_SERVER_LOG_MAX_FILE=3
